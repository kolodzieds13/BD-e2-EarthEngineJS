  print("Applying NDVI + Canopy Cover Filter");
  
  // Calculate absolute difference between cover and NDVI for each feature
  var sampledWithGeoDiff = sampledPoints.map(function(feat) {
    var ndvi = ee.Number(feat.get('NDVI'));
    var cover = ee.Number(feat.get('cover'));  // Assumes 'cover' exists in GEDI data
    
    // Calculate absolute difference
    var geoDiff = cover.subtract(ndvi).abs();
    
    return feat.set('geoDiff', geoDiff);
  });
  
  // Calculate mean and standard deviation of geoDiff across all points
  var geoDiffValues = sampledWithGeoDiff.aggregate_array('geoDiff');
  var geoDiffMean = geoDiffValues.reduce(ee.Reducer.mean());
  var geoDiffStdDev = geoDiffValues.reduce(ee.Reducer.stdDev());
  
  print('GeoDiff Mean:', geoDiffMean);
  print('GeoDiff StdDev:', geoDiffStdDev);
  
  // Filter features where geoDiff < 1 standard deviation
  sampledPoints = sampledWithGeoDiff.map(function(feat) {
    var geoDiff = ee.Number(feat.get('geoDiff'));
    var zScore = geoDiff.divide(geoDiffStdDev);
    
    return feat.set('geoDiff_zscore', zScore);
  }).filter(ee.Filter.lt('geoDiff_zscore', 1));
  
  print('Points after NDVI filter:', sampledPoints.size());
}


