var qualityMaskXX = function(im) {
  var img = im.updateMask(im.select('l4_quality_flag').eq(1))
  img = img.updateMask(img.select('l2_quality_flag').eq(1))
  img = img.updateMask(img.select('degrade_flag').eq(0))
  return img
}
//Time of Day Observations
var solarElevMask = function(im){
  return im.updateMask(im.select('solar_elevation').lt(solarElevThres))
}
//Sensitivity Threshold
var sensitivityMask = function(im){
  return im.updateMask(im.select('sensitivity').gte(sensitivityThres))
}
//Beam Type
var beamFilter = function(im){
  if (beamType == 'power'){
    return im.updateMask(im.select('beam').gt(3))
  }
  if (beamType == 'coverage'){
    return im.updateMask(im.select('beam').lte(3))
  }
  if (beamType == 'all'){
    return im
  }
}

