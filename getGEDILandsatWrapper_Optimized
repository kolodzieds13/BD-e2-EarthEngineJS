var addLSMetadata = function(img){
  // Extract metadata values
  var path = img.getNumber('WRS_PATH');
  var row = img.getNumber('WRS_ROW');
  var sensorNum = ee.Number.parse(ee.String(img.get('SPACECRAFT_ID')).split('_').get(1));
  var cloudCover = img.getNumber('CLOUD_COVER');
  var lsDateValue = ee.Number.parse(img.date().format('YYYYMMdd'));
  
  // Create constant bands for ALL metadata
  var pathBand = ee.Image.constant(path).rename('path').toInt();
  var rowBand = ee.Image.constant(row).rename('row').toInt();
  var sensorBand = ee.Image.constant(sensorNum).rename('sensor').toInt();
  var cloudBand = ee.Image.constant(cloudCover).rename('cloud_cover').toFloat();
  var lsDateBand = ee.Image.constant(lsDateValue).rename('lsDate').toInt();
  
  return img.addBands([pathBand, rowBand, sensorBand, cloudBand, lsDateBand]);
}

