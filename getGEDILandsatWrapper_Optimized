        var quality = ee.Image(
            modL2B.date()
              .difference(modL2A.date(), 'day')
              .abs()
              .multiply(-1)
          )
          .rename('L2AL2B_dateDiff') // -(number of days from the image)
        return modL2B
          .addBands(quality)
          .float()
      })
      .qualityMosaic('L2AL2B_dateDiff')

    return modL2A.addBands(modL2B)
  })

