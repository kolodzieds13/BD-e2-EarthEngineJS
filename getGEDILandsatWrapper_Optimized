var sampleBestLandsat = function(gediFeature) {
  
  var matches = ee.List(gediFeature.get('landsat_matches'));
  var numMatches = matches.size();
  var hasMatches = numMatches.gt(0);
  
  var result = ee.Algorithms.If(
    hasMatches.not(),
    null,
    (function() {
      var gediGeom = gediFeature.geometry();
      var gediTime = ee.Number(gediFeature.get('system:time_start'));
      
      var matchCol = ee.ImageCollection.fromImages(matches);
      
      // Testing
      // var projInfo = matchCol.first().select('blue').projection()
      
      // Calculate time difference and add as constant band
      var matchesWithDiff = matchCol.map(function(img) {
        var timeDiff = ee.Date(img.date()).difference(ee.Date(gediTime), 'day').abs();
        var quality = timeDiff.multiply(-1);  // Invert for qualityMosaic
        
        // Add both as bands
        var timeDiffBand = ee.Image.constant(timeDiff).rename('timeDiff_days').toFloat();
        var qualityBand = ee.Image.constant(quality).rename('quality').toFloat();
        
        return img.addBands([timeDiffBand, qualityBand]);
      });
      
      // Quality mosaic - selects closest valid pixel
      var gediMasterLS = matchesWithDiff.qualityMosaic('quality');
      
      // Final Prep before sampling:
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
//                Final Updates to Data
//
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////


      if (simpleLandsat){
        print('Applying Scale Factor - Reflectance')
        var optical=gediMasterLS.select(bandDictionary['reflectanceSimple']).multiply(10000).int16() //'lsDate'
      } else {
        var optical=gediMasterLS.select(bandDictionary['reflectanceAll']).multiply(10000).int16() //'lsDate'
      }
      
      gediMasterLS = gediMasterLS.addBands(optical,null,true)
      
      if (addElevation){
        print('Applying Scale Factor - Elevation')
        var terrain100B = gediMasterLS.select(bandDictionary['terrain100']).multiply(100).int16()
        var terrain10kB = gediMasterLS.select(bandDictionary['terrain10k']).multiply(10000).int16()
        
        gediMasterLS = gediMasterLS.addBands(terrain100B,null,true)
        gediMasterLS = gediMasterLS.addBands(terrain10kB,null,true)
      }
      
      if (addGLCMEVI){
        print('Applying Scale Factor - GLCM')
        var glcm10kB = gediMasterLS.select(bandDictionary['glcm10k']).multiply(10000).int16() 
        var glcmOneThousandB = gediMasterLS.select(bandDictionary['glcmOneThousand']).multiply(1000).int16()
        var glcmDNB = gediMasterLS.select(bandDictionary['glcmDN']).int16()
        
        gediMasterLS = gediMasterLS.addBands(glcm10kB,null,true)
        gediMasterLS = gediMasterLS.addBands(glcmOneThousandB,null,true)
        gediMasterLS = gediMasterLS.addBands(glcmDNB,null,true)
      }  
      
      // if (addGLCMvarNIR){
      //   print('Applying Scale Factor - GLCM NIR')
      //   var glcmDNB = gediMasterLS.select(bandDictionary['glcmNIRDN']).int16()
      //   gediMasterLS = gediMasterLS.addBands(glcmDNB,null,true)
      // }
      
      // if (addGLCMconSWIR1){
      //   print('Applying Scale Factor - GLCM SWIR1')
      //   var glcmDNB = gediMasterLS.select(bandDictionary['glcmSWIR1DN']).int16()
      //   gediMasterLS = gediMasterLS.addBands(glcmDNB,null,true)
      // }  
      
      print(gediMasterLS.bandNames,"Final Band Names")        
      
      
      
      
      // Add Additional Criteria you want to include to output CSV
      

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//
//                Convert Raster to Points and Sample
//
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////        
      
      //Apply Sample
      var sample = gediMasterLS.reduceRegion({
        reducer: ee.Reducer.first(),
        geometry: gediGeom,
        scale: null,
        crs: lsProj, // replaced bestPixel.select('blue').projection() with projInfo
        bestEffort: false // change from false to true
      });
      
      var sampledFeature = ee.Feature(gediGeom, sample)
        .copyProperties(gediFeature,null,['landsat_matches']);
      
      return sampledFeature;
    })()
  );
  
  return ee.Feature(result);
};


