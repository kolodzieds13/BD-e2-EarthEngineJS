var KenobiOrder = Kenobi_TileIDs.map(function(IDs){
 
  
  // Select Start and End Days (in Julian Days)
  var startJulian = 1
  var endJulian = 180//365
  // Select Start and End Years
  // Note: GEDI Observation are avaliable from 2019 through 2023
  // Year 2023 only has data till March: endJulian no later than 91
  var startYear = 2019
  var endYear= 2019
  
  // Define Area of Interest (AOI)
  // This may need to be broken up if area is too large
  var AOI = Kenobi_TileSchema_v5.filter(ee.Filter.eq('zoneID',IDs))
  
  // Select Projection
  var imgCRS = 'EPSG:32610' //5070 / 32610
  // Select Scale: Desired resolution of data.
  var imgScale = null
  // Select Transform. Transform is used to ensure proper snapping to other datasets
  var imgTransform = [25, 0, 248650, 0, -25, 5323275]//[30,0,-2361915,0,-30,3177735]
  
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //
  //                Export Parameters
  //
  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  
  // Name of Output CSV file
  var outName = 'GEDI_Landsat_Fusion'
  // Name of Output Directory
  var outDir = "BDe2_Gamma" //This must be created in Google Drive
  
  
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //
  //                Functions
  //
  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  
  //Dropping Degraded Observations
  var qualityMaskXX = function(im) {
    var img = im.updateMask(im.select('l4_quality_flag').eq(1))
    img = img.updateMask(img.select('l2_quality_flag').eq(1))
    img = img.updateMask(img.select('degrade_flag').eq(0))
    return img
  }
  //Time of Day Observations
  var solarElevMask = function(im){
    return im.updateMask(im.select('solar_elevation').lt(solarElevThres))
  }
  //Sensitivity Threshold
  var sensitivityMask = function(im){
    return im.updateMask(im.select('sensitivity').gte(sensitivityThres))
  }
  //Beam Type
  var beamFilter = function(im){
    if (beamType == 'power'){
      return im.updateMask(im.select('beam').gt(3))
    }
    if (beamType == 'coverage'){
      return im.updateMask(im.select('beam').lte(3))
    }
    if (beamType == 'all'){
      return im
    }
  }
  // //GEDI Date YYYYMMdd
  // var addDateGEDI = function(im){
  //   var doy = im.date().format('YYYYMMdd');
  //   var doyBand = ee.Image.constant(ee.Number.parse(doy)).add(ee.Image.constant(1)).rename('gediDate').toInt()
  //   return im.addBands(doyBand);
  // };
  
  var addDateGEDI = function(im){
    var doy = im.date().format('YYYYMMdd');
    var doyBand = ee.Image.constant(ee.Number.parse(doy)).rename('gediDate').toInt()
    return im.addBands(doyBand);
  };
  
  
  
  var addLSDate = function(im){
    var doy = im.date().format('YYYYMMdd');
    var doyBand = ee.Image.constant(ee.Number.parse(doy)).rename('lsDate').toInt()
  
    return im.addBands(doyBand);
  };
  
  
  var applyGLCMEVI = function(img){
    var boxcar = ee.Kernel.square({
      radius: 2, units: 'pixels', normalize: true
    });
        
    var glcmPrep = img.select('EVI')
      .multiply(ee.Number(10000))
      .toInt16()
      .unitScale(-10000,10000)
      .multiply(255)
      .toByte()
      
    // Kernel 7 x 7
    var glcm3 = glcmPrep.glcmTexture({
      size:3,
      kernel: ee.Kernel.square({
      radius: 3, units: 'pixels', normalize: true})
    })
    
    var glcm3_smooth = glcm3.convolve(boxcar).select(bandDictionary['glcm']); 
    return img.addBands(glcm3_smooth)
  }
  
  var applyGLCMvarNIR = function(img){
    var boxcar = ee.Kernel.square({
      radius: 2, units: 'pixels', normalize: true
    });
        
    var glcmPrep = img.select('nir')
      .multiply(ee.Number(10000))
      .toInt16()
      .unitScale(-10000,10000)
      .multiply(255)
      .toByte()
      
    // Kernel 7 x 7
    var glcm3 = glcmPrep.glcmTexture({
      size:2,
      kernel: ee.Kernel.square({
      radius: 2, units: 'pixels', normalize: true})
    })
    
    var glcm3_smooth = glcm3.convolve(boxcar).select(bandDictionary['glcmNIR']); 
    return img.addBands(glcm3_smooth)
  }
  
  var applyGLCMconSWIR1 = function(img){
    var boxcar = ee.Kernel.square({
      radius: 2, units: 'pixels', normalize: true
    });
        
    var glcmPrep = img.select('swir1')
      .multiply(ee.Number(10000))
      .toInt16()
      .unitScale(-10000,10000)
      .multiply(255)
      .toByte()
      
    // Kernel 7 x 7
    var glcm3 = glcmPrep.glcmTexture({
      size:2,
      kernel: ee.Kernel.square({
      radius: 2, units: 'pixels', normalize: true})
    })
    
    var glcm3_smooth = glcm3.convolve(boxcar).select(bandDictionary['glcmSWIR1']); 
    return img.addBands(glcm3_smooth)
  }
  
  
  
  
  
  
  
  
  
  
  
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //
  //                Band Dictionary
