  var bandDictionary = {
    "reflectanceAll":ee.List(["blue","green","red","nir","swir1","swir2","NDVI","NIRv","NBR","NDMI","EVI","SAVI","brightness",
                    "greenness","wetness","tcAngleBG","tcAngleGW","tcAngleBW","tcDistBG","tcDistGW","tcDistBW"]),
    "reflectanceSimple":ee.List(["blue","green","red","nir","swir1","swir2","NDVI","EVI","NBR"]), // New add 20260112
    
    "glcm":ee.List(['EVI_asm','EVI_contrast','EVI_corr','EVI_var','EVI_idm','EVI_savg','EVI_svar',
                    'EVI_sent','EVI_ent','EVI_dvar','EVI_dent','EVI_imcorr1','EVI_imcorr2',]),
              
    "glcm10k":ee.List(["EVI_asm","EVI_idm","EVI_corr","EVI_sent","EVI_dent","EVI_imcorr1","EVI_imcorr2"]),
    "glcmDN":  ee.List(["EVI_contrast","EVI_var","EVI_svar","EVI_savg","EVI_dvar"]),
    "glcmOneThousand" : ee.List(["EVI_ent",]),
    
    "glcmNIR":ee.List(['nir_var']),
    "glcmNIRDN":ee.List(['nir_var']),
    
    
    "glcmSWIR1":ee.List(['swir1_contrast']),
    "glcmSWIR1DN":ee.List(['swir1_contrast']),
    
    
              
    
    
    
    
    "terrain100":ee.List(['slope','tpi11','tpi21','tpi41']),
    "terrain10k":ee.List(["sinAspect",'cosAspect','HLI']),
    
    "gediAll":ee.List(['agbd','agbd_pi_lower','agbd_pi_upper','agbd_se','agbd_t','agbd_t_se',
                      'l4_quality_flag','l2_quality_flag','degrade_flag','delta_time','solar_elevation','beam','sensitivity',
                      'rh25','rh50', 'rh75','rh95','rh98','digital_elevation_model','digital_elevation_model_srtm',
                      'cover','pai']),
    
    "gediL4A":ee.List(['agbd','agbd_pi_lower','agbd_pi_upper','agbd_se','agbd_t','agbd_t_se',
                      'l4_quality_flag','l2_quality_flag','degrade_flag','delta_time',
                      'solar_elevation','beam','sensitivity']),
    "gediL2A":ee.List(['delta_time','rh25','rh50', 'rh75','rh95','rh98','elev_lowestmode','digital_elevation_model','digital_elevation_model_srtm']),
    "gediL2B":ee.List(['delta_time','cover','pai']),
    
  }
  
  
  
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //
  //                Prepare GEDI Data
  //
  //////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  
  // Load Collections
  
  var GEDI_L2A = ee.ImageCollection('LARSE/GEDI/GEDI02_A_002_MONTHLY')
    .filterBounds(AOI)
    .filter(ee.Filter.calendarRange(startYear,endYear,'year'))
    .filter(ee.Filter.calendarRange(startJulian,endJulian))
  var GEDI_L2B = ee.ImageCollection('LARSE/GEDI/GEDI02_B_002_MONTHLY')
    .filterBounds(AOI)
    .filter(ee.Filter.calendarRange(startYear,endYear,'year'))
    .filter(ee.Filter.calendarRange(startJulian,endJulian))
  var GEDI_L4A = ee.ImageCollection('LARSE/GEDI/GEDI04_A_002_MONTHLY')
    .filterBounds(AOI)
    .filter(ee.Filter.calendarRange(startYear,endYear,'year'))
    .filter(ee.Filter.calendarRange(startJulian,endJulian))
  
  print('GEDI_L2A',GEDI_L2A.first())
  print('GEDI_L2B',GEDI_L2B.first())
  print('GEDI_L4A',GEDI_L4A.first())
  
  // Indicate Desired Bands
  
  // var GEDI_L2A_Selection = ['delta_time','rh25','rh50', 'rh75','rh95','rh98','digital_elevation_model','digital_elevation_model_srtm']
  // var GEDI_L2B_Selection = ['delta_time','cover','pai']
  // var GEDI_L4A_Selection = ['delta_time','agbd','l4_quality_flag','l2_quality_flag','degrade_flag','solar_elevation','beam','sensitivity']
  
  var modL2A = GEDI_L2A.select(bandDictionary['gediL2A'])
  var modL2B = GEDI_L2B.select(bandDictionary['gediL2B'])
  GEDI_L4A = GEDI_L4A.select(bandDictionary['gediL4A'])
  
  // https://gis.stackexchange.com/questions/376961/is-there-a-way-to-merge-imagecollections-in-earth-engine-without-the-systemind
  
  // Merge Collections
  
  var GEDI_L2Coll = ee.ImageCollection(
    ee.Join.saveAll({matchesKey: 'join'}) // This creates a new field in properties
      // Add an 's1' property to each s2 image, with a list of s1 imagery from within 16 days
      .apply({ 
        primary: modL2A, 
        secondary: modL2B, //GEDI_L2B
        condition:
          ee.Filter.equals({leftField: 'system:index', rightField: 'system:index'}) // Change from delta_time to system index
      })
    )
  
  // GEDI_L2Coll = GEDI_L2Coll 
    .map(function (modL2A) {
      var modL2B = ee.ImageCollection.fromImages(
          ee.List(modL2A.get('join'))
        )
        .map(function (modL2B) {
          var quality = ee.Image(
              modL2B.date()
                .difference(modL2A.date(), 'day')
                .abs()
                .multiply(-1)
            )
            .rename('L2AL2B_dateDiff') // -(number of days from the image)
          return modL2B
            .addBands(quality)
            .float()
        })
        .qualityMosaic('L2AL2B_dateDiff')
  
      return modL2A.addBands(modL2B)
    })
  
  // // Display Results  
  // Map.addLayer(GEDI_L2Coll,{},"GEDI_L2Coll")
  // print(GEDI_L2Coll,"GEDI_L2Coll")
  
  var gediMaster = ee.ImageCollection(
    ee.Join.saveAll({matchesKey: 'join02'})
      // Add an 'GEDI L2' property to each GEDI l4A image, with a list of s1 imagery from within 16 days
      .apply({ 
        primary: GEDI_L4A, 
        secondary: GEDI_L2Coll, //GEDI_L2B
        condition:
          ee.Filter.equals({leftField: 'system:index', rightField: 'system:index'}) //IMPORTANT : Maybe shot_number instead?
      })
    )
    // Add the s1 band (a mosaica from the pixels closest to the s2 image)
  // print(gediMaster,"gediMaster")  
  gediMaster = gediMaster 
    .map(function (GEDI_L4A) {
      var GEDI_L2Coll_img = ee.ImageCollection.fromImages(
          ee.List(GEDI_L4A.get('join02'))
        )
        .map(function (GEDI_L2Coll_img) {
          var quality = ee.Image(
              GEDI_L2Coll_img.date()
                .difference(GEDI_L4A.date(), 'day')
                .abs()
                .multiply(-1)
            )
            .rename('L2L4A_dateDiff') // -(number of days from the s2 image)
          return GEDI_L2Coll_img
            .addBands(quality)
            .float()
            // // .updateMask(GEDI_L4A.select('cover').mask()) //GEDI_L2B_Attribution.reduce('sum').gte(1))//
        })
        .qualityMosaic('L2L4A_dateDiff') // Review Later do i need quality mosaic()
        // .first()
      return GEDI_L4A.addBands(GEDI_L2Coll_img)
  
    })
  
  
  // Get Final GEDI Product
  
  var finalGedi_v2 = gediMaster.map(qualityMaskXX)
  finalGedi_v2 = finalGedi_v2.map(solarElevMask)
  finalGedi_v2 = finalGedi_v2.map(sensitivityMask)
  finalGedi_v2 = finalGedi_v2.map(beamFilter)
  finalGedi_v2 = finalGedi_v2.map(addDateGEDI)
  
  // finalGedi_v2 = finalGedi_v2.map(reprojectGEDI)
  
  print(finalGedi_v2,"gediMaster")
  Map.addLayer(finalGedi_v2,{},"gediMaster FINAL")
  
  
  
  // Define a max difference filter to compare timestamps.
  var maxDiffFilter = ee.Filter.maxDifference({
    difference: 20 * 24 * 60 * 60 * 1000, // first value ('20') is the number of days
    leftField: 'system:time_start',
    rightField: 'system:time_start'
  });
  
  var intersects = ee.Filter.intersects({
    leftField: '.geo',
    rightField: '.geo',
    maxError: 10
  });
  
  
  //////////////////////////////////////////////////////////////////
  //
  //             Prepare Landsat Data using GTAC Module
  //
  /////////////////////////////////////////////////////////////////
  
  
  //Module imports
  // var getImagesLib = require('users/aaronkamoske/GTAC-Modules:getImagesLib.js');
  // var getImagesLib = require('users/davidkolodziejski/GEDI:getImages_ArgusGeo')
  ///////////////////////////////////////////////////////////////////////////////
  // Define user parameters:
  var args = {};
  
  // Specify study area: Study area
  // Can be a featureCollection, feature, or geometry
  args.studyArea = AOI//Kenobi_AOI//AOI;
  
  var Validation04 = AOI//Kenobi_AOI//AOI
  
  // Update the startJulian and endJulian variables to indicate your seasonal 
  // constraints. This supports wrapping for tropics and southern hemisphere.
  // If using wrapping and the majority of the days occur in the second year, the system:time_start will default 
  // to June 1 of that year.Otherwise, all system:time_starts will default to June 1 of the given year
  // startJulian: Starting Julian date 
  // endJulian: Ending Julian date
  
    // Annual = 1 - 365
    // Spring = 60 - 152 : March Through May
    // Summer = 152 - 244: June through August
    // Fall = 244 - 335: Sepetember through November
    // Winter = 335 - 60: December through February
  
  
  
  args.startJulian = startJulian;  //152
  args.endJulian = endJulian;    // 244
  
  // Specify start and end years for all analyses
  // More than a 3 year span should be provided for time series methods to work 
  // well. If providing pre-computed stats for cloudScore and TDOM, this does not 
  // matter
  args.startYear = startYear; //2000
  args.endYear = endYear; //2022
  
  
  // var StartMonth = ee.Number(6);
  // var EndMonth = ee.Number(9);
  
  
  var StartYr = args.startYear//ee.Number(args.startYear);
  var EndYr = args.endYear//ee.Number(args.endYear);
  
  print(StartYr,"StartYr")
  print(EndYr,"EndYr")
  
  
  // var rez = ee.Number(30) // Meters
  
  // var proxy = Start.subtract(ee.Number(2000))
  
  
  // Specify an annual buffer to include imagery from the same season 
  // timeframe from the prior and following year. timeBuffer = 1 will result 
  // in a 3 year moving window. If you want single-year composites, set to 0
  args.timebuffer =0;
  
  // Specify the weights to be used for the moving window created by timeBuffer
  // For example- if timeBuffer is 1, that is a 3 year moving window
  // If the center year is 2000, then the years are 1999,2000, and 2001
  // In order to overweight the center year, you could specify the weights as
  // [1,5,1] which would duplicate the center year 5 times and increase its weight for
  // the compositing method. If timeBuffer = 0, set to [1]
  args.weights = [1];
  
  // Choose medoid or median compositing method. 
  // Median tends to be smoother, while medoid retains 
  // single date of observation across all bands
  // The date of each pixel is stored if medoid is used. This is not done for median
  // If not exporting indices with composites to save space, medoid should be used
  args.compositingMethod = 'medoid';
  
  // Choose Top of Atmospheric (TOA) or Surface Reflectance (SR) 
  args.toaOrSR = 'TOA';
  
  // Choose which Landsat USGS Collection version to use
  // Choices are 'C1' for Collection 1 and 'C2' for Collection 2
  // Only choose 'C1' if working with other Collection 1 data and using
  // data from before 1/1/2022. Otherwise, choose 'C2'
  // See: https://www.usgs.gov/landsat-missions/landsat-collection-2 for more information
  args.landsatCollectionVersion = 'C2';
  
  // Choose whether to include Landat 7
  // Generally only included when data are limited
  args.includeSLCOffL7 = false;
  
  // Whether to defringe L4 and L5
  // Landsat 4 and 5 data have fringes on the edges that can introduce anomalies into 
  // the analysis.  This method removes them, but is somewhat computationally expensive
  args.defringeL5 = true;
  
  // Choose cloud/cloud shadow masking method
  // Choices are a series of booleans for cloudScore, TDOM, and elements of Fmask
  // Fmask masking options will run fastest since they're precomputed
  // Fmask cloud mask is generally very good, while the fMask cloud shadow
  // mask isn't great. TDOM tends to perform better than the Fmask cloud shadow mask. cloudScore 
  // is usually about as good as the Fmask cloud mask overall, but each fails in different instances.
  // CloudScore runs pretty quickly, but does look at the time series to find areas that 
  // always have a high cloudScore to reduce commission errors- this takes some time
  // and needs a longer time series (>5 years or so)
  // TDOM also looks at the time series and will need a longer time series
  // If pre-computed cloudScore offsets and/or TDOM stats are provided below, cloudScore
  // and TDOM will run quite quickly
  args.applyCloudScore = true;
  args.applyFmaskCloudMask = true;
  
  args.applyTDOM = true;
  args.applyFmaskCloudShadowMask = true;
  
  args.applyFmaskSnowMask = false//false;
  
  // If applyCloudScore is set to true
  // cloudScoreThresh: lower number masks more clouds.  Between 10 and 30 generally 
  // works best
  args.cloudScoreThresh = 20//20;
  
  // Whether to find if an area typically has a high cloudScore
  // If an area is always cloudy, this will result in cloud masking omission
  // For bright areas that may always have a high cloudScore
  // but not actually be cloudy, this will result in a reduction of commission errors
  // This procedure needs at least 5 years of data to work well
  // Precomputed offsets can be provided below
  args.performCloudScoreOffset = true;
  
  // If performCloudScoreOffset = true:
  // Percentile of cloud score to pull from time series to represent a minimum for 
  // the cloud score over time for a given pixel. Reduces comission errors over 
  // cool bright surfaces. Generally between 5 and 10 works well. 0 generally is a
  // bit noisy but may be necessary in persistently cloudy areas
  args.cloudScorePctl = 10; 
  
  // zScoreThresh: If applyTDOM is true, this is the threshold for cloud shadow masking- 
  // lower number masks out less. Between -0.8 and -1.2 generally works well
  args.zScoreThresh = -1;
  
  // shadowSumThresh:  If applyTDOM is true, sum of IR bands to include as shadows within TDOM and the 
  //    shadow shift method (lower number masks out less)
  args.shadowSumThresh = 0.35;
  
  // contractPixels: The radius of the number of pixels to contract (negative 
  //    buffer) clouds and cloud shadows by. Intended to eliminate smaller cloud 
  //    patches that are likely errors
  // (1.5 results in a -1 pixel buffer)(0.5 results in a -0 pixel buffer)
  // (1.5 or 2.5 generally is sufficient)
  args.contractPixels = 1.5; 
  
  // dilatePixels: The radius of the number of pixels to dilate (buffer) clouds 
  //    and cloud shadows by. Intended to include edges of clouds/cloud shadows 
  //    that are often missed
  // (1.5 results in a 1 pixel buffer)(0.5 results in a 0 pixel buffer)
  // (2.5 or 3.5 generally is sufficient)
  args.dilatePixels = 5;
  
  // Choose the resampling method: 'near', 'bilinear', or 'bicubic'
  // Defaults to 'near'
  // If method other than 'near' is chosen, any map drawn on the fly that is not
  // reprojected, will appear blurred
  // Use .reproject to view the actual resulting image (this will slow it down)
  args.resampleMethod = 'bilinear'//'bicubic';
  
  // If available, bring in preComputed cloudScore offsets and TDOM stats
