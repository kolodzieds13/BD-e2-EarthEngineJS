  // =======================================================
  
  // Join the GEDI collection (primary) with Landsat (secondary)
  // We use saveAll to get ALL potential matches within 20 days.
  var gediMasterLS = ee.ImageCollection(
    ee.Join.saveAll({
      matchesKey: 'matches'
    }).apply({ 
      primary: finalGedi_v2, 
      secondary: lsPrep_wIndicies, // Assumes this already has 'lsDate' band [cite: 1]
      condition: joinFilter
    })
  );
  
  // =======================================================
  // 3. PROCESS MATCHES (Find Best Valid Pixel)
  // =======================================================
  
  var processedCol = gediMasterLS.map(function (gediImg) {
    
    // 1. Get the list of Landsat matches for this specific GEDI image
    var matchesList = ee.List(gediImg.get('matches'));
    var matchCol = ee.ImageCollection.fromImages(matchesList);
    
    // 2. Calculate time difference for every pixel in every match
    var matchColWithDiff = matchCol.map(function (lsImg) {
      

      var doy = lsImg.date().format('YYYYMMdd');
      var doyBand = ee.Image.constant(ee.Number.parse(doy)).rename('lsDate')
      
      var timeDiff = lsImg.date()
        .difference(gediImg.date(), 'day')
        .abs(); 
        
      // We invert the diff because qualityMosaic prefers higher numbers.
      // -0 days (best) > -5 days (worst).
      var qualityBand = ee.Image.constant(timeDiff)
        .multiply(-1)
        .rename('timeMatchQuality');
      
      return lsImg.addBands(qualityBand).addBands(doyBand)
                  .float()
                  // Update mask: Only keep pixels where Landsat is valid (e.g. not cloud masked)
                  .updateMask(lsImg.select('blue').mask()); 
    });
    
    // 3. Collapse to the single best Landsat pixel
    // This automatically carries over the 'lsDate' band from the winning pixel
    var bestLandsat = matchColWithDiff.qualityMosaic('timeMatchQuality');
  
    // 4. Combine GEDI + Best Landsat
    // We explicitly select the bands we want to avoid clutter, but ensure dates are included
    return gediImg.addBands(bestLandsat).clip(AOI.geometry().buffer(100)); 
  });
  
  // =======================================================
  // 4. PREPARE FOR EXPORT (Add Lat/Lon)
  // =======================================================
  
  // We map over the processed collection to add Lat/Lon bands to every image
  var finalCollection = processedCol.map(function(img){
    var latLon = ee.Image.pixelLonLat(); // Adds 'latitude' and 'longitude' bands
    return img.addBands(latLon);
  });
  
  // =======================================================
  // 5. SAMPLING & EXPORT
  // =======================================================
  
  // If you want to sample EVERY valid GEDI pixel without mosaicking them together:
  // We map .sample() over the collection and flatten the results. 
  // This is safer than mosaicking if you have overlapping GEDI shots you want to preserve.
  
  var roi = AOI.geometry().bounds(100,'EPSG:32610')
  
  var table = finalCollection.map(function(img) {
    return img.sample({
      region: roi,
      scale: 25, 
      projection: 'EPSG:32610', // Force Lat/Lon projection for the CSV coords
      geometries: false,       // We don't need the geometry column anymore, we have Lat/Lon bands
      dropNulls: true          // Drops pixels where GEDI or Landsat were masked
    });
  }).flatten();
  
  // Export
  Export.table.toDrive({
    collection: table,
    description: "GEDI_Landsat_Joined_v3_WithCoords_NearestNoSnap",
    folder: 'testImg', // [cite: 1]
    fileFormat: 'CSV',
    selectors: ['agbd', 'gediDate','lsDate', 'latitude', 'longitude', 'blue', 'red', 'nir', 'swir1', 'swir2'] 
    // ^ Explicitly list columns to ensure order and exclude junk bands like 'timeMatchQuality'
  });
  
  
    // Filter to the exact date you want to validate
  
  
  // Convert 20190429 -> ee.Date('2019-04-29')
  var targetDate = ee.Date.parse('YYYY-MM-dd', '2019-04-29');
  
  // Filter using the image's actual date property
  var targetLS = lsPrep_wIndicies.filter(
    ee.Filter.date(targetDate, targetDate.advance(1, 'day'))
  ).first();
  
  
  print(targetLS,"targetLS")
  
  getImagesLib.exportToDriveWrapper(
    targetLS.float(),
    'TEST_Landsat_Date20190429_v99_NearestNoSnap',
    'testImg',
    AOI,
    30,
    'EPSG:32610',
    null,
    // args.transform,
    -32768);
  
  
  
  
  ///////////////////////////////////////////////////////////////////////////////////////////////
  //
  //               Apply NDVI Filter (Optional)
  //
  ///////////////////////////////////////////////////////////////////////////////////////////////
  
  if (applyNDVIFilter){
    print("Applying NDVI + Canopy Cover Filter")
    
    var ndvi = gediMasterLS.select('NDVI')
    var cover = gediMasterLS.select('cover')
    //Get Adbsolute Difference
    var geoDiffNDVIprepped = (cover.subtract(ndvi)).abs().rename('geoDiff')
    
    var reducers = ee.Reducer.mean().combine({
      reducer2: ee.Reducer.stdDev(),
      sharedInputs: true});
    
    var stats = geoDiffNDVIprepped.reduceRegion({
        reducer: reducers,
        geometry: Validation04,
        crs: imgCRS,
        crsTransform: imgTransform,
        maxPixels: 1e10
    })
    
    var geoDiffMean = ee.Number(stats.get('geoDiff_mean'))
    var geoDiffSTD = ee.Number(stats.get('geoDiff_stdDev'))
    
    var geoDiffFilter = geoDiffNDVIprepped.divide(geoDiffSTD)
    var geoDiffFilterMask = geoDiffFilter.lt(1) //i.e. less than 1 StDev
    
    gediMasterLS = gediMasterLS.updateMask(geoDiffFilterMask)
  }
  
  
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //
  //                Apply SRTM Elevation
  //
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  
  if (addElevation){
    print('Adding SRTM Elevation')
    // grab SRTM Data
    var srtm = ee.Image("USGS/SRTMGL1_003")
      .resample("bicubic")
      .select(['elevation'],['demSRTM'])
     
    var PI = ee.Image.constant(ee.Number.expression('Math.PI', null))
    // grab Aspect
    var aspect = ee.Terrain.aspect(srtm);
    // grab Slope
    var slope = ee.Terrain.slope(srtm)
    // Grab Folded Aspect
    var aspectRadians = aspect.multiply(0.0174533)
    // grab Sin and Cosine Aspect
    // https://www.researchgate.net/post/How_to_use_aspects_ie_N_NE_SE_etc_in_PCA_or_CCA_for_analysis_especially_using_PAST
    var sinAspect = aspectRadians.sin().rename("sinAspect")
    var cosAspect = aspectRadians.cos().rename("cosAspect")
    
    var slopeRadians = slope.multiply(0.0174533)
  
    // //Calculate heat load index, based on Theobald et al (2015)
    // //https://github.com/zachlevitt/earth-engine/blob/master/topoModules.md#theobaldhlihttps://github.com/zachlevitt/earth-engine/blob/master/topoModules.md#theobaldhli
  
  
    var foldedAspect = aspectRadians.subtract(ee.Number(4.3196899)).abs().multiply(ee.Number(-1)).add(PI).abs().rename('foldedAspect')
    var theobaldHLI = (slopeRadians.cos().multiply(ee.Number(1.582)).multiply(ee.Number(0.82886954044))).subtract(foldedAspect.cos().multiply(ee.Number(1.5)).multiply(slopeRadians.sin().multiply(ee.Number(0.55944194062)))).subtract(slopeRadians.sin().multiply(ee.Number(0.262)).multiply(ee.Number(0.55944194062))).add(foldedAspect.sin().multiply(ee.Number(0.607)).multiply(slopeRadians.sin())).add(ee.Number(-1.467)).rename('HLI');
    
    // Add Topographic Posidition Index
    var mean01 = srtm.focalMean(5.5, 'square');
    var tpi11 = srtm.subtract(mean01).rename("tpi11")
    var mean02 = srtm.focalMean(10.5, 'square');
    var tpi21 = srtm.subtract(mean02).rename("tpi21")
    var mean03 = srtm.focalMean(20.5, 'square');
    var tpi41 = srtm.subtract(mean03).rename("tpi41")
    
    // Stack Terrain Variables
    var newTerrainVariable = srtm.addBands(slope).addBands(sinAspect).addBands(cosAspect)//.addBands(NorthnessExpo).addBands(EastnessExpo)
      .addBands(tpi11).addBands(tpi21).addBands(tpi41).addBands(theobaldHLI)//.addBands(foldedAspect)
    
    gediMasterLS = gediMasterLS.addBands(newTerrainVariable)
  
  }
  
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //
  //                Add ESA Global Landcover 2021
  //
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  
  if (addESALandcover){
    print('Adding ESA Global Landcover 2021 Landuse and Landcover')
    // grab SRTM Data
    
    var esaLandcover = ee.ImageCollection('ESA/WorldCover/v200').first()
    .select(['Map'],['esaLC_2021'])
    .unmask(9999)
    
  
    gediMasterLS = gediMasterLS.addBands(esaLandcover)
  
  }
  
  
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //
  //                Add ESA Forest Types 2019
  //
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  
  if (addESAForestTypes){
    print('Adding ESA Forest Types')
    // grab SRTM Data
    
    var esaForestType = ee.Image('COPERNICUS/Landcover/100m/Proba-V-C3/Global/2019')
    .select(['forest_type'],['esaFT_2019'])
    .unmask(9999)
    
  
    gediMasterLS = gediMasterLS.addBands(esaForestType)
  
  }
  
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //
  //                Add Global Forest Types
  //
  ///////////////////////////////////////////////////////////////////////////////////////////////////////
  
  if (addJRCGlobalForestTypes){
    print('Adding JRC Global Forest Types')
    var GFT2020 = ee.ImageCollection('JRC/GFC2020_subtypes/V0').mosaic()
    .rename('jrcGFT_2020')
    .unmask(9999)
    
    gediMasterLS = gediMasterLS.addBands(GFT2020)
  
  }
  
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //
  //                Add Hansen Global Tree Loss
  //
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  
  if (addHansenTreeLoss){
    print('Adding Hansen Tree Loss')
    // grab SRTM Data
    
    var hansenTreeLoss = ee.Image('UMD/hansen/global_forest_change_2024_v1_12')
    .select(['lossyear','loss','gain'],['hnsnLossYr','hnsnLoss','hnsnGain'])
    .unmask(9999)
    
  
    gediMasterLS = gediMasterLS.addBands(hansenTreeLoss)
  
  }
  
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //
  //                Add Flow Index
  //
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  
  if (addFlowIndex){
    print('Adding Flow Index')
    // grab SRTM Data
    
    var cti = ee.ImageCollection("projects/sat-io/open-datasets/HYDROGRAPHY90/flow_index/cti")
    .filterBounds(AOI)
    .mosaic()
    .resample("bicubic")
    .rename('cti')
    var spi = ee.ImageCollection("projects/sat-io/open-datasets/HYDROGRAPHY90/flow_index/spi")
    .filterBounds(AOI)
    .mosaic()
    .resample("bicubic")
    .rename('spi')
    var sti = ee.ImageCollection("projects/sat-io/open-datasets/HYDROGRAPHY90/flow_index/sti")
    .filterBounds(AOI)
    .mosaic()
    .resample("bicubic")
    .rename('sti')
    
  
    gediMasterLS = gediMasterLS.addBands(cti).addBands(spi).addBands(sti)
  
  }
  
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //
  //                Add Height Above Nearest Drainage (HAND) Hydrology
  //
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  
  if (addHANDHydro){
    print('Adding Height Above Nearest Drainage (HAND) Hydrology')
    // grab SRTM Data
    
    var hand30_100 = ee.ImageCollection("users/gena/global-hand/hand-100")
    .filterBounds(AOI)
    .mosaic()
    .resample("bicubic")
    .rename('hand30_100m')
    var hand30_1000 = ee.Image("users/gena/GlobalHAND/30m/hand-1000")
    .resample("bicubic")
    .rename('hand30_1k')
    var hand90_1000 = ee.Image("users/gena/GlobalHAND/90m-global/hand-1000")
    .resample("bicubic")
    .rename('hand90_1k')
    
    gediMasterLS = gediMasterLS.addBands(hand30_100).addBands(hand30_1000).addBands(hand90_1000)
  
  }
  
  
  
  
  
  
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //
  //                Final Updates to Data
  //
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  
  
  if (simpleLandsat){
    var optical=gediMasterLS.select(bandDictionary['reflectanceSimple']).multiply(10000).int16() //'lsDate'
  } else {
    var optical=gediMasterLS.select(bandDictionary['reflectanceAll']).multiply(10000).int16() //'lsDate'
  }
  
  gediMasterLS = gediMasterLS.addBands(optical,null,true)
  
  if (addElevation){
    var terrain100B = gediMasterLS.select(bandDictionary['terrain100']).multiply(100).int16()
    var terrain10kB = gediMasterLS.select(bandDictionary['terrain10k']).multiply(10000).int16()
    
    gediMasterLS = gediMasterLS.addBands(terrain100B,null,true)
    gediMasterLS = gediMasterLS.addBands(terrain10kB,null,true)
  }
  
  if (addGLCMEVI){
    var glcm10kB = gediMasterLS.select(bandDictionary['glcm10k']).multiply(10000).int16() 
    var glcmOneThousandB = gediMasterLS.select(bandDictionary['glcmOneThousand']).multiply(1000).int16()
    var glcmDNB = gediMasterLS.select(bandDictionary['glcmDN']).int16()
    
    gediMasterLS = gediMasterLS.addBands(glcm10kB,null,true)
    gediMasterLS = gediMasterLS.addBands(glcmOneThousandB,null,true)
    gediMasterLS = gediMasterLS.addBands(glcmDNB,null,true)
  }  
  
  if (addGLCMvarNIR){
    var glcmDNB = gediMasterLS.select(bandDictionary['glcmNIRDN']).int16()
    gediMasterLS = gediMasterLS.addBands(glcmDNB,null,true)
  }
  
  if (addGLCMconSWIR1){
    var glcmDNB = gediMasterLS.select(bandDictionary['glcmSWIR1DN']).int16()
    gediMasterLS = gediMasterLS.addBands(glcmDNB,null,true)
  }  
  
  print(gediMasterLS.bandNames,"Final Band Names")
  Map.addLayer(gediMasterLS,{},"with Landsat",false)
  
  
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //
  //                Convert Raster to Points and Sample
  //
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  
  
  //Extracting values
  var sampled_points2 = gediMasterLS.sample({ //--> or should I use 'reduceRegions'? If that makes more sence, what would the code look like for  'reduceRegions'?
    region: AOI,
    scale: 25,//imgScale,
    // crsTransform: imgTransform,
    projection: imgCRS,
    geometries: true
  });
  
  var featColExport = sampled_points2.map(function (feature) {
    // Get geometry
    var coordinates = feature.geometry()
                            .transform(imgCRS)// <= Come Back
                            .coordinates();
                            
    var lonInt=ee.Number(coordinates.get(0)).abs().int32() //A
    var latInt=ee.Number(coordinates.get(1)).abs().int32()  //B
    
    var uniqid = ee.Number(10).pow((latInt.log10().add(1).int())).multiply(lonInt).add(latInt)
    
    
    // var uniqid = feature.get('masterFrac').toDouble().format('%.18f')
    
    // Get both entries of coordinates and set them as new properties
    var resul = feature.set('lon', coordinates.get(0), 
                      'lat', coordinates.get(1),
                      'uniqid',uniqid) //.format('%.18f')
                      // 'uniqid'coordinates.get(0).add(coordinates.get(1)),
                      // 'zone',zone,
                      // 'tileID',IDs);
    // Remove geometry                   
    return resul.setGeometry(null)
  })
  
  
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  //
  //                Export Data to Google Drive
  //
  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  
  
  Export.table.toDrive({
    collection: featColExport,
    description: outName+"_tile"+IDs+"_"+startYear.toString()+"_"+endYear.toString()+"_"+startJulian.toString()+"_"+endJulian.toString()+"_"+dateToday,
    folder: outDir,
    fileFormat: 'CSV'
  });


})
