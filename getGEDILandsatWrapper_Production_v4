   */
  var addIndices = function(image) {
    // 1. NDVI = (NIR - Red) / (NIR + Red)
    var ndvi = image.normalizedDifference(['nir', 'red']).rename('NDVI');
    
    // 2. EVI = 2.5 * ((NIR - Red) / (NIR + 6 * Red - 7.5 * Blue + 1))
    var evi = image.expression(
      '2.5 * ((NIR - RED) / (NIR + 6 * RED - 7.5 * BLUE + 1))', {
        'NIR': image.select('nir'),
        'RED': image.select('red'),
        'BLUE': image.select('blue')
      }).rename('EVI');
  
    // 3. NBR = (NIR - SWIR2) / (NIR + SWIR2)
    // Standard index for burn severity and biomass disturbance.
    var nbr = image.normalizedDifference(['nir', 'swir2']).rename('NBR');
  
    return image.addBands([ndvi, evi, nbr]);
  };
  
