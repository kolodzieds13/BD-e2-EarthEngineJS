  /**
   * Mask clouds/shadows on Raw DN data (Level 1)
   */
  var maskCloudsC2 = function(image) {
    var qa = image.select('QA_PIXEL');
    // Bit 1: Dilated Cloud, Bit 3: Cloud, Bit 4: Cloud Shadow
    var mask = qa.bitwiseAnd(1 << 1).eq(0)
          .and(qa.bitwiseAnd(1 << 3).eq(0))
          .and(qa.bitwiseAnd(1 << 4).eq(0));
    return image.updateMask(mask);
  };
  
  /**
   * Convert Raw DN to TOA Reflectance
   * Formula: ((DN * 0.0000275) - 0.2) / sin(SunElevation)
   */
  var applyTOAConversion = function(image) {
    // 1. Apply Scale Factors
    var opticalBands = image.select(['B2', 'B3', 'B4', 'B5', 'B6', 'B7'])
                            .multiply(0.0000275).add(-0.2);
                            
    // 2. Correct for Sun Elevation
    var sunElevation = ee.Number(image.get('SUN_ELEVATION'));
    var sunElevRad = sunElevation.multiply(Math.PI).divide(180);
    
    // 3. Calculate TOA and Clamp
    // CRITICAL: We clamp to [0, 1]. EVI math fails if values are negative.
    var toaReflectance = opticalBands.divide(sunElevRad.sin())
                                     .clamp(0, 1); 
  
    return image.addBands(toaReflectance, null, true)
                .copyProperties(image, ['system:time_start', 'SUN_ELEVATION']);
  };
  
