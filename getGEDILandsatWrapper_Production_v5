  /**
   * Robust Cloud Masking for Collection 2 TOA Data
   * masks Dilated Cloud (Bit 1), Cloud (Bit 3), and Shadow (Bit 4)
   */
  var maskCloudsTOA = function(image) {
    var qa = image.select('QA_PIXEL');
    var mask = qa.bitwiseAnd(1 << 1).eq(0) // Dilated Cloud
          .and(qa.bitwiseAnd(1 << 3).eq(0)) // Cirrus/Cloud
          .and(qa.bitwiseAnd(1 << 4).eq(0)); // Cloud Shadow
    return image.updateMask(mask);
  };
  
  /**
