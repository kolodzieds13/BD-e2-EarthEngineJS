    leftField: 'system:time_start',
    rightField: 'system:time_start'
  });
  
  var joinFilter = ee.Filter.and(
    maxDiffFilter, 
    ee.Filter.intersects({leftField: '.geo', rightField: '.geo', maxError: 10})
  );
  
  // Use saveAll to find ALL potential matches
  var gediMasterLS = ee.ImageCollection(
    ee.Join.saveAll({
      matchesKey: 'matches'
    }).apply({ 
      primary: finalGedi_v2, 
      secondary: lsPrep_wIndicies, 
      condition: joinFilter
    })
  );
  
  // =======================================================
  // 5. RESOLVE MATCHES (Find Closest Valid Date)
  // =======================================================
  
    var roi = AOI.geometry().bounds(100,'EPSG:32610')
  
  var processedCol = gediMasterLS.map(function (gediImg) {
    
    // 1. Retrieve matches
    var matchesList = ee.List(gediImg.get('matches'));
    var matchCol = ee.ImageCollection.fromImages(matchesList);
    
    // 2. Score matches by time difference
    var matchColWithDiff = matchCol.map(function (lsImg) {
      
      var doy = lsImg.date().format('YYYYMMdd');
      var doyBand = ee.Image.constant(ee.Number.parse(doy)).rename('lsDate').double()

      
      var timeDiff = lsImg.date().difference(gediImg.date(), 'day').abs(); 
        
