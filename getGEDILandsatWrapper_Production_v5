   */
  var addLSDate = function(image){
    var doy = image.date().format('YYYYMMdd');
    var doyBand = ee.Image.constant(ee.Number.parse(doy)).rename('lsDate').toInt();
    return image.addBands(doyBand);
  };
  
  /**
   * Add Spectral Indices: NDVI, EVI, NBR
   */
  var addIndices = function(image) {
    // NDVI = (NIR - Red) / (NIR + Red)
    var ndvi = image.normalizedDifference(['nir', 'red']).rename('NDVI');
    
    // NBR = (NIR - SWIR2) / (NIR + SWIR2) [Forestry Standard]
    var nbr = image.normalizedDifference(['nir', 'swir2']).rename('NBR');
    
    // EVI = 2.5 * ((NIR - Red) / (NIR + 6 * Red - 7.5 * Blue + 1))
    var evi = image.expression(
      '2.5 * ((NIR - RED) / (NIR + 6 * RED - 7.5 * BLUE + 1))', {
        'NIR': image.select('nir'),
        'RED': image.select('red'),
        'BLUE': image.select('blue')
      }).rename('EVI');
  
    return image.addBands([ndvi, nbr, evi]);
  };
  
  // =======================================================
