var lcms_dataPrepped = lcms_data.map(function(img){
  var lcmsLandCover = img.select(['Land_Cover'])
  var lcsmProbability = img.select(['Change_Raw_Probability_Slow_Loss',
    'Change_Raw_Probability_Fast_Loss','Change_Raw_Probability_Gain', 
    'Land_Cover_Raw_Probability_Trees'])
    
  var lcmsChange = img.select(['Change']) //.select(['Change', 'Land_Cover', 'Land_Use'])
  
  
  
  
      // Create a binary mask.
  var stable = lcmsChange.eq(1).select(['Change'],['lcms_Stable']);
  var slowLoss = lcmsChange.eq(2).select(['Change'],['lcms_SlowLoss']);
  var fastLoss = lcmsChange.eq(3).select(['Change'],['lcms_fastLoss']);
  var gain = lcmsChange.eq(4).select(['Change'],['lcms_Gain']);
  
  var lmcsChangeDummy = stable.addBands(slowLoss).addBands(fastLoss).addBands(gain).addBands(lcsmProbability)
  return lmcsChangeDummy
  // Map.addLayer(lmcsChangeDummy,{},"lmcsChangeDummy")

})

