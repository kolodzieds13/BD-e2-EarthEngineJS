var qualityMask100 = function(im) {
  return im.updateMask(im.select('quality_flag').eq(1))
      .updateMask(im.select('degrade_flag').eq(0));
};

var reprojectIMG = function(im){
  return im.reproject({
    crs: 'EPSG:32610',
    crsTransform: getImagesLib.common_projections.NLCD_CONUS.transform})
}

var getYear = (function(im){
  var date= ee.Date(im.get('system:time_start'))
  return im.set('year', ee.Number(date.get('year')))
})

//   })

// Define a max difference filter to compare timestamps.
var maxDiffFilter = ee.Filter.maxDifference({
  difference: 24 * 24 * 60 * 60 * 1000,
  leftField: 'system:time_start',
  rightField: 'system:time_start'
});

var intersects = ee.Filter.intersects({
  leftField: '.geo',
  rightField: '.geo',
  maxError: 10
});


var GEDI_L2A_Attribution = ee.ImageCollection('LARSE/GEDI/GEDI02_A_002_MONTHLY')
    .map(qualityMask100)
    .map(reprojectIMG)
    .map(getYear)
    .select(['elev_lowestmode', 'digital_elevation_model_srtm'])
    // .filterDate('2019-01-01', '2019-12-31')
    .filterDate(ee.Date.fromYMD(StartYr,1,1),ee.Date.fromYMD(EndYr,12,31))
    .filterBounds(Validation04);

  
// var gediSensitivityMask = gediAttribution.select('sensitivity').gte(0.98)
var GEDI_L2B_Attribution = ee.ImageCollection('LARSE/GEDI/GEDI02_B_002_MONTHLY')
    .map(qualityMask99)
    .map(reprojectIMG)
    .map(getYear)
    .select(['cover', 'sensitivity','shot_number_within_beam']) //'pai'
    // .filterDate('2019-01-01', '2019-12-31')
    .filterDate(ee.Date.fromYMD(StartYr,1,1),ee.Date.fromYMD(EndYr,12,31))
    .filterBounds(Validation04);

var gedi4AColl = ee.ImageCollection('LARSE/GEDI/GEDI04_A_002_MONTHLY')
    .map(qualityMask)
    .map(reprojectIMG)
    .map(getYear)
    .select(['agbd', 'solar_elevation'])
    // .filterDate('2019-01-01', '2019-12-31')
    .filterDate(ee.Date.fromYMD(StartYr,1,1),ee.Date.fromYMD(EndYr,12,31))
    .filterBounds(Validation04);
    
var gediMaster = ee.ImageCollection(
  ee.Join.saveAll({matchesKey: 'gedi'})
    // Add an 's1' property to each s2 image, with a list of s1 imagery from within 16 days
    .apply({ 
      primary: GEDI_L2B_Attribution, 
      secondary: gedi4AColl, 
      condition: ee.Filter.and(maxDiffFilter, intersects)
    })
  )
  // Add the s1 band (a mosaica from the pixels closest to the s2 image)
  .map(function (GEDI_L2B_Attribution) {
    var gedi4AColl = ee.ImageCollection.fromImages(
        ee.List(GEDI_L2B_Attribution.get('gedi'))
      )
      .map(function (gedi4AColl) {
        var quality = ee.Image(
            gedi4AColl.date()
              .difference(GEDI_L2B_Attribution.date(), 'day')
              .abs()
              .multiply(-1)
          )
          .rename('quality') // -(number of days from the s2 image)
        return gedi4AColl
          .addBands(quality)
          .float()
          .updateMask(GEDI_L2B_Attribution.select('cover').mask()) //GEDI_L2B_Attribution.reduce('sum').gte(1))//
      })
      .qualityMosaic('quality') 
      .select(['agbd', 'solar_elevation'])
    return GEDI_L2B_Attribution.addBands(gedi4AColl)
      .updateMask(GEDI_L2B_Attribution.select('sensitivity').gte(0.98))
      .updateMask(gedi4AColl.select('solar_elevation').lt(0))
  })

