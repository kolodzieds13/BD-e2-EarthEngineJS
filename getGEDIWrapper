var qualityMask = function(im) {
  return im.updateMask(im.select('l4_quality_flag').eq(1))
      .updateMask(im.select('degrade_flag').eq(0));
};

var qualityMask99 = function(im) {
  return im.updateMask(im.select('l2b_quality_flag').eq(1))
      .updateMask(im.select('degrade_flag').eq(0));
};
// var GEDI_L2B_Attribution = ee.ImageCollection('LARSE/GEDI/GEDI02_B_002_MONTHLY')
