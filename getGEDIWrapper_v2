    })
  )
  // Add the s1 band (a mosaic from the pixels closest to the s2 image)
  .map(function (lsPrep_wIndicies) {
    var gediMasterLCMS = ee.ImageCollection.fromImages(
        ee.List(lsPrep_wIndicies.get('gedi'))
      )
