var GEDI_L2A_Selection = ['delta_time','rh25','rh50', 'rh75','rh95','rh98','digital_elevation_model','digital_elevation_model_srtm']
var GEDI_L2B_Selection = ['delta_time','cover','pai']
var GEDI_L4A_Selection = ['delta_time','agbd','l4_quality_flag','l2_quality_flag','degrade_flag','solar_elevation','beam','sensitivity']

var modL2A = GEDI_L2A.select(GEDI_L2A_Selection)
var modL2B = GEDI_L2B.select(GEDI_L2B_Selection)
GEDI_L4A = GEDI_L4A.select(GEDI_L4A_Selection) // important! 

var GEDI_L2Coll = ee.ImageCollection(
  ee.Join.saveAll({matchesKey: 'join'}) // This creates a new field in properties
    // Add an 's1' property to each s2 image, with a list of s1 imagery from within 16 days
    .apply({ 
      primary: modL2A, 
      secondary: modL2B, //GEDI_L2B
      condition:
        ee.Filter.equals({leftField: 'system:index', rightField: 'system:index'}) // Change from delta_time to system index
    })
  )
  // Add the s1 band (a mosaica from the pixels closest to the s2 image)
  
// GEDI_L2Coll = GEDI_L2Coll 
  .map(function (modL2A) {
    var modL2B = ee.ImageCollection.fromImages(
        ee.List(modL2A.get('join'))
      )
      .map(function (modL2B) {
        var quality = ee.Image(
            modL2B.date()
              .difference(modL2A.date(), 'day')
              .abs()
              .multiply(-1)
          )
          .rename('quality') // -(number of days from the s2 image)
        return modL2B
          .addBands(quality)
          .float()
          // .updateMask(GEDI_L4A.select('cover').mask()) //GEDI_L2B_Attribution.reduce('sum').gte(1))//
      })
      .qualityMosaic('quality')
      // .select(['cover','pai','quality'])
      // .select(['rh25','rh50', 'rh75','rh95','rh98'])
    return modL2A.addBands(modL2B)
      // .updateMask(GEDI_L4A.select('sensitivity').gte(0.98))
      // .updateMask(GEDI_L2B.select('solar_elevation').lt(0))
  })
  
