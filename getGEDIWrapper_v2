              .difference(lsPrep_wIndicies.date(), 'day')
              .abs()
              .multiply(-1)
          )
          .rename('quality') // -(number of days from the s2 image)
        return gediMasterLCMS
          .addBands(quality)
          .float()
          .updateMask(lsPrep_wIndicies.reduce('sum').gte(1))//.mask())
      })
      .qualityMosaic('quality') 
